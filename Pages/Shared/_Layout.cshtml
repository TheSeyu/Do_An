<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Nhà hàng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <header class="topbar">
        <a class="brand" asp-page="/Index">Nhà hàng</a>
        <nav>
            @if (User.IsInRole(RoleNames.Cashier) || User.IsInRole(RoleNames.Admin))
            {
                <a asp-page="/Cashier/Index">Thu ngân</a>
            }
            @if (User.IsInRole(RoleNames.Admin))
            {
                <a asp-page="/Account/Register">Tạo tài khoản</a>
                <a asp-page="/Admin/QrCodes">Mã QR bàn</a>
                <a asp-page="/Admin/Revenue">Báo cáo doanh thu</a>
                <a asp-page="/Admin/Inventory">Kho</a>
            }
        </nav>
        <div class="who">
            <span>@User.FindFirst("FullName")?.Value</span>
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="btn btn-ghost">Đăng xuất</button>
            </form>
        </div>
    </header>
}
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

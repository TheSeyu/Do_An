@page
@model RestaurantOrder.Pages.Account.LoginModel
@{ ViewData["Title"] = "Đăng nhập"; }

<main class="auth">
    <section class="auth-card">
        <aside class="auth-side" aria-hidden="true">
            <p class="side-title">Nhà hàng</p>
            <p class="side-text">Thu ngân và quản lý đăng nhập tại đây để bắt đầu ca làm.</p>
            <div class="mini-floor">
                @for (var i = 1; i <= 12; i++)
                {
                    <span class="@(i is 2 or 3 or 6 or 9 ? "busy" : "")">@i.ToString("00")</span>
                }
            </div>
        </aside>

        <div class="auth-form">
            <h1>Đăng nhập</h1>
            <p class="muted">Dành cho nhân viên. Khách gọi món bằng mã QR trên bàn, không cần đăng nhập.</p>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label asp-for="Input.Username"></label>
                    <input asp-for="Input.Username" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Username" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="error"></span>
                </div>

                <label class="check">
                    <input asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>

                <button type="submit" class="btn btn-primary btn-block">Đăng nhập</button>
            </form>
            <p class="muted small">Chưa có tài khoản? Quản lý nhà hàng sẽ tạo cho bạn.</p>
        </div>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
